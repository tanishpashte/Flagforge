/* Color variables */
$background: #11111b;
$surface: #181825;
$accent: #89b4fa;
$border-inactive: #313244;
$border-active: #89b4fa;
$text: #cdd6f4;
$text-muted: #7f849c;

Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

/* Custom Header styling */
CustomHeader {
    dock: top;
    height: 3;
    background: $surface;
    border-bottom: tall $border-inactive;
    padding: 0 2;
}

#header-container {
    layout: horizontal;
    height: 100%;
}

#header-title {
    content-align: left middle;
    width: 1fr;
}

#header-status {
    content-align: center middle;
    width: 2fr;
    color: $text-muted;
}

ClockWidget {
    content-align: right middle;
    width: 1fr;
    color: #f9e2af;
}

/* Search Bar styling */
#search-bar {
    margin: 1 1 0 1;
    background: $surface;
    border: tall $border-inactive;
    color: $text;
}

#search-bar:focus {
    border: tall $border-active;
}

/* Dashboard Grid Layout */
#dashboard-grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 2fr;
    padding: 1;
    grid-gutter: 2;
    height: 1fr;
}

#right-column {
    layout: vertical;
}

/* List views as panels */
ListView {
    background: $surface;
    border: round $border-inactive;
    border-title-color: $text-muted;
    border-subtitle-color: #45475a;
    border-subtitle-align: right;
    padding: 1;
    height: 100%;
}

#right-column > ListView {
    height: 1fr;
    margin-bottom: 1;
}

#right-column > ListView:last-child {
    margin-bottom: 0;
}

ListView:focus {
    border: round $border-active;
    border-title-color: $border-active;
    border-subtitle-color: $text;
    background: #1e1e2e;
}

/* List Items styling */
ListItem {
    padding: 0 1;
    background: transparent;
    color: $text;
    height: auto;
    border-left: solid transparent;
}

ListView > ListItem.-highlight {
    background: #181825;
    color: $text-muted;
    border-left: solid #313244;
}

ListView:focus > ListItem.-highlight {
    background: #313244;
    color: #cdd6f4;
    text-style: bold;
    border-left: solid $accent;
}

/* Disable default ListView border when focused to avoid double border */
ListView > ListItem {
    border: none;
}

/* Modal dialog styling */
ConfigEditModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.5);
}

#modal-dialog {
    width: 60;
    height: auto;
    border: thick $border-active;
    background: $surface;
    padding: 1 2;
}

#modal-label {
    margin-top: 1;
    margin-bottom: 1;
    width: 100%;
    content-align: center middle;
}

#modal-input {
    margin-bottom: 1;
    background: $background;
    border: tall $border-inactive;
    color: $text;
}

#modal-input:focus {
    border: tall $border-active;
}

#modal-buttons {
    layout: horizontal;
    align: center middle;
    height: 3;
    content-align: center middle;
}

#modal-buttons Button {
    margin: 0 2;
    width: 15;
}

/* FlagRuleModal styling */
FlagRuleModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.5);
}

#rule-modal-dialog {
    width: 60;
    height: auto;
    border: thick $border-active;
    background: $surface;
    padding: 1 2;
}

#rule-modal-label {
    margin-top: 1;
    margin-bottom: 1;
    width: 100%;
    content-align: center middle;
}

#rule-type-list {
    height: 7;
    margin-bottom: 1;
    border: tall $border-inactive;
    background: $background;
}

#rollout-input-container {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

#rollout-input {
    margin-top: 1;
    background: $background;
    border: tall $border-inactive;
    color: $text;
}

#rollout-input:focus {
    border: tall $border-active;
}

#rule-modal-buttons {
    layout: horizontal;
    align: center middle;
    height: 3;
    content-align: center middle;
}

#rule-modal-buttons Button {
    margin: 0 2;
    width: 15;
}

